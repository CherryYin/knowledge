# =============================================
# Knowledgebase - 环境变量配置模板
# =============================================
# 复制此文件为 .env 并根据实际情况修改
# cp .env.example .env

# =============================================
# 数据库配置 (必需)
# =============================================

# PostgreSQL 连接字符串 (pgvector)
# 格式：postgresql://用户名：密码@主机：端口/数据库名
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/knowledge

# pgvector 连接串（Pipeline 使用，默认同 DATABASE_URL）
PGVECTOR_DSN=postgresql://postgres:postgres@localhost:5432/knowledge

# 是否允许在没有数据库的情况下启动服务 (开发调试用)
# 0 = false, 1 = true
ALLOW_START_WITHOUT_DB=0

# 是否跳过数据库迁移
# 0 = false, 1 = true
DB_SKIP_MIGRATION=0

# =============================================
# Redis 配置 (Celery 异步任务必需)
# =============================================

# Redis 连接 URL
REDIS_URL=redis://localhost:6379/0

# =============================================
# Embedding 服务配置 (必需)
# =============================================

# vLLM Embedding 服务地址
EMBEDDING_BASE_URL=http://localhost:8100

# Embedding 模型名称
EMBEDDING_MODEL=Qwen/Qwen2.5-VL-Embedding

# 向量维度（默认 1536）
# EMBEDDING_DIM=1536

# 是否使用本地 Transformers 模型 (替代 vLLM)
# 需要先安装：poetry install --extras local-embed
# false = 使用 vLLM, true = 使用本地模型
USE_LOCAL_EMBEDDING=false

# =============================================
# TOC 抽取 LLM 配置 (必需)
# =============================================

# TOC 抽取用的 LLM 模型名
TOC_LLM_MODEL=qwen2.5-72b-instruct

# LLM 服务地址（兼容 OpenAI API 格式）
TOC_LLM_BASE_URL=http://localhost:8000/v1

# LLM API Key（本地部署可填 not-needed）
TOC_LLM_API_KEY=not-needed

# LLM 分段最大 token 数（默认 6000）
# TOC_LLM_MAX_SEGMENT_TOKENS=6000

# =============================================
# 分块策略配置 (可选)
# =============================================

# 最小 chunk token 数（低于此值会向上合并）
CHUNK_MIN_TOKENS=200

# 最大 chunk token 数（超过此值会二次切分）
CHUNK_MAX_TOKENS=512

# 二次切分时的重叠 token 数
CHUNK_OVERLAP_TOKENS=64

# =============================================
# FAQ 存储配置 (FAQ 摄入必需)
# =============================================

# FAQ SQLite 数据库路径
FAQ_DB_PATH=./data/faq.db

# =============================================
# Blob 对象存储配置 (可选，用于存储原始文档和抽取的图片)
# =============================================

# 存储后端类型：none | s3 | azure
BLOB_BACKEND=none

# --- S3 / MinIO 配置 ---
# S3 兼容端点（留空则用 AWS 默认端点）
# BLOB_S3_ENDPOINT=http://minio:9000

# S3 Bucket 名称
# BLOB_S3_BUCKET=knowledge-docs

# AWS Access Key / Secret Key
# BLOB_S3_ACCESS_KEY=your-access-key
# BLOB_S3_SECRET_KEY=your-secret-key

# S3 区域（默认 us-east-1）
# BLOB_S3_REGION=us-east-1

# 对象键前缀（默认 documents/）
# BLOB_S3_PREFIX=documents/

# 图片存储专用配置（可选，默认与文档相同 bucket）
# BLOB_S3_IMAGE_BUCKET=knowledge-images
# BLOB_S3_IMAGE_PREFIX=images/

# --- Azure Blob Storage 配置 ---
# Azure 连接字符串
# BLOB_AZURE_CONN_STR=DefaultEndpointsProtocol=https;AccountName=...

# Azure Container 名称
# BLOB_AZURE_CONTAINER=documents

# Azure Blob 前缀
# BLOB_AZURE_PREFIX=documents/

# Azure 图片存储专用配置（可选）
# BLOB_AZURE_IMAGE_CONTAINER=images
# BLOB_AZURE_IMAGE_PREFIX=images/

# =============================================
# 外部文档分块同步 (可选)
# =============================================

# 外部系统的基础 URL
# DOCUMENT_SEGMENTS_BASE_URL=http://127.0.0.1:8001

# 外部系统的路径
# DOCUMENT_SEGMENTS_PATH=/api/v1/document_segments

# 外部系统的 Bearer Token (不含 "Bearer " 前缀)
# DOCUMENT_SEGMENTS_TOKEN=your-secret-token

# 外部系统请求超时时间 (秒)
# DOCUMENT_SEGMENTS_TIMEOUT_SECONDS=8

# =============================================
# TLS / SSL 证书配置 (企业网络可选)
# =============================================

# 自定义 CA 证书路径 (如公司内网需要)
# SSL_CA_BUNDLE=/path/to/your-ca.pem

# 是否验证 SSL 证书
# 生产环境建议保持 true
SSL_VERIFY=true

# =============================================
# CORS 跨域配置 (可选)
# =============================================

# 允许的源，逗号分隔
# 留空表示仅允许同源
# ALLOW_ORIGINS=https://example.com,https://admin.example.com
ALLOW_ORIGINS=

# 是否允许携带凭证 (cookies/authorization headers)
ALLOW_CREDENTIALS=false

# =============================================
# HTTP 超时配置 (可选)
# =============================================

# HTTP 请求超时时间 (秒)
HTTP_TIMEOUT_SECONDS=8

# =============================================
# 服务运行配置 (可选)
# =============================================

# 监听地址
HOST=0.0.0.0

# 监听端口
PORT=8000

# 是否启用热重载（开发环境）
# RELOAD=true

# =============================================
# GPU 加速配置 (可选)
# =============================================

# 文档解析是否使用 GPU 加速（MinerU）
# USE_GPU=true
